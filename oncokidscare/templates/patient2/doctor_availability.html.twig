{% extends 'base.html.twig' %}

{% block title %}Disponibilités{% endblock %}

{% block body %}
    <input type="hidden" name="csrf_token" id="csrf_token" value="{{ csrf_token('rendezvous_token') }}">

    <div class="container-fluid page-header py-5 mb-5 wow fadeIn" data-wow-delay="0.1s">
        <div class="container py-5">
            <h1 class="display-3 text-white mb-3 animated slideInDown">Disponibilités</h1>
            <nav aria-label="breadcrumb animated slideInDown">
                <ol class="breadcrumb text-uppercase mb-0">
                    <li class="breadcrumb-item"><a class="text-white" href="#">Accueil</a></li>
                    <li class="breadcrumb-item text-primary active" aria-current="page">Disponibilités</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="container-fluid py-5">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <h2 class="text-center mb-4">Disponibilité du Dr. {{ doctor.nom }} {{ doctor.prenom }}</h2>
                    
                    <div id="toast-container" class="position-fixed top-0 end-0 p-3" style="z-index: 1050;"></div>
                    
                    {% if dates is defined and dates|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-bordered text-center">
                                <thead>
                                    <tr>
                                        <th>Heure</th>
                                        {% for date in dates %}
                                            {% set dayOfWeek = date|date('N') %}
                                            {% if dayOfWeek <= 5 %}
                                                {% set dayName = date|date('l')|replace({
                                                    'Monday': 'Lundi',
                                                    'Tuesday': 'Mardi',
                                                    'Wednesday': 'Mercredi',
                                                    'Thursday': 'Jeudi',
                                                    'Friday': 'Vendredi'
                                                }) %}
                                                <th>{{ dayName }}<br>{{ date|date('d/m/Y') }}</th>
                                            {% endif %}
                                        {% endfor %}
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for hour in hours %}
                                        <tr>
                                            <td>{{ hour }}:00</td>
                                            {% for date in dates %}
                                                {% set dayOfWeek = date|date('N') %}
                                                {% if dayOfWeek <= 5 %}
                                                    {% set dateStr = date|date('Y-m-d') %}
                                                    {% set isAvailable = true %}
                                                    
                                                    {# Check existing appointments #}
                                                    {% for rdv in rendezvous %}
                                                        {% if rdv.dateTime|date('Y-m-d') == date|date('Y-m-d') and rdv.dateTime|date('H') == hour %}
                                                            {% set isAvailable = false %}
                                                        {% endif %}
                                                    {% endfor %}

                                                    {# Check doctor availability #}
                                                    {% for availability in doctorAvailability %}
                                                        {% if availability.date|date('Y-m-d') == date|date('Y-m-d') and availability.hour == hour %}
                                                            {% set isAvailable = availability.isAvailable %}
                                                        {% endif %}
                                                    {% endfor %}

                                                    <td>
                                                        {% if isAvailable %}
                                                            <div class="slot-available" 
                                                                onclick="selectTimeSlot(this)"
                                                                data-date="{{ date|date('Y-m-d') }}"
                                                                data-hour="{{ hour }}"
                                                                data-doctor="{{ doctor.id }}">
                                                                <i class="fas fa-check-circle text-success"></i>
                                                            </div>
                                                        {% else %}
                                                            <div class="slot-unavailable">
                                                                <i class="fas fa-times-circle text-danger"></i>
                                                            </div>
                                                        {% endif %}
                                                    </td>
                                                {% endif %}
                                            {% endfor %}
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        
                        <div class="text-center mt-4">
                            <button id="bookButton" class="btn btn-primary" disabled>Confirmer le rendez-vous</button>
                        </div>
                    {% else %}
                        <p class="text-center">Aucune disponibilité trouvée.</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <script>
        let selectedSlot = null;
        const bookButton = document.getElementById('bookButton');

        async function bookAppointment(date, hour, doctorId) {
            try {
                const csrfToken = document.getElementById('csrf_token').value;
                const response = await fetch('{{ path('app_patient_rendezvous_book') }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': csrfToken
                    },
                    body: JSON.stringify({ date, hour, doctorId })
                });

                const data = await response.json();
                if (!response.ok) {
                    throw new Error(data.message || 'Server error');
                }

                return data;
            } catch (error) {
                console.error('Booking error:', error);
                throw error;
            }
        }

        function showToast(message, isSuccess = true) {
            const toastContainer = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `alert alert-${isSuccess ? 'success' : 'danger'} alert-dismissible fade show`;
            toast.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            `;
            toastContainer.appendChild(toast);
            
            setTimeout(() => {
                toast.remove();
            }, 3000);
        }

        function selectTimeSlot(element) {
            if (selectedSlot) {
                selectedSlot.classList.remove('slot-selected');
            }
            element.classList.add('slot-selected');
            selectedSlot = element;
            bookButton.disabled = false;
        }

        bookButton.addEventListener('click', async function() {
            if (!selectedSlot) {
                showToast('Veuillez sélectionner un créneau horaire', false);
                return;
            }

            bookButton.disabled = true;

            try {
                const result = await bookAppointment(
                    selectedSlot.dataset.date,
                    parseInt(selectedSlot.dataset.hour),
                    selectedSlot.dataset.doctor
                );

                if (result.success) {
                    showToast(result.message, true);
                    selectedSlot.classList.remove('slot-available', 'slot-selected');
                    selectedSlot.classList.add('slot-unavailable');
                    selectedSlot.removeAttribute('onclick');
                    selectedSlot.innerHTML = '<i class="fas fa-times-circle text-danger"></i>';
                    selectedSlot = null;
                } else {
                    throw new Error(result.message);
                }
            } catch (error) {
                showToast(error.message || 'Une erreur est survenue', false);
                bookButton.disabled = false;
            }
        });
    </script>

    <style>
        .slot-available {
            cursor: pointer;
            padding: 10px;
            transition: all 0.3s;
        }
        
        .slot-available:hover {
            background-color: rgba(40, 167, 69, 0.1);
        }
        
        .slot-selected {
            background-color: rgba(40, 167, 69, 0.2);
        }
        
        .slot-unavailable {
            padding: 10px;
            opacity: 0.5;
        }
    </style>
{% endblock %}
