{% extends 'base.html.twig' %}

{% block title %}Modifier la commande{% endblock %}

{% block css %}
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --pharmacy-primary: #00BFA5;
            --pharmacy-secondary: rgb(156, 238, 224);
            --pharmacy-bg-gradient: linear-gradient(135deg, #e3f2fd, #f0f4c3);
            --pharmacy-card-bg: rgba(255, 255, 255, 0.95);
            --pharmacy-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .pharmacy-page {
            background: var(--pharmacy-bg-gradient);
            font-family: 'Poppins', sans-serif;
            min-height: 100vh;
            padding-top: 2rem;
            position: relative;
            overflow: hidden;
        }

        .floating-pills {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
        }

        .pill {
            position: absolute;
            width: 50px;
            height: 25px;
            background: linear-gradient(90deg, #ff4b4b 50%, #ffd700 50%);
            border-radius: 50px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            animation: float 10s infinite ease-in-out;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .pill::before {
            content: '';
            width: 100%;
            height: 3px;
            background: rgba(0, 0, 0, 0.2);
            border-radius: 2px;
            position: absolute;
            top: 50%;
            left: 0;
            transform: translateY(-50%);
        }

        .pill::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(145deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0));
            border-radius: 50px;
            pointer-events: none;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            25% { transform: translateY(-20px) rotate(10deg); }
            50% { transform: translateY(20px) rotate(-10deg); }
            75% { transform: translateY(-20px) rotate(10deg); }
        }

        .pharmacy-container {
            animation: fadeIn 1s ease-in-out;
            position: relative;
            z-index: 2;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .pharmacy-title {
            color: var(--pharmacy-primary);
            font-weight: 700;
            text-align: center;
            margin-bottom: 1.5rem;
            font-size: 2.5rem;
        }

        .pharmacy-subtitle {
            color: #666;
            text-align: center;
            margin-bottom: 2rem;
        }

        .pharmacy-card {
            background: var(--pharmacy-card-bg);
            border-radius: 15px;
            padding: 2rem;
            margin: 0 auto;
            max-width: 800px; /* Largeur maximale pour une grande carte */
            box-shadow: var(--pharmacy-shadow);
            transition: all 0.3s ease;
            transform-style: preserve-3d;
        }

        .pharmacy-card:hover {
            transform: translateY(-10px) rotateX(5deg);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
        }

        .pharmacy-card-title {
            color: var(--pharmacy-primary);
            font-weight: 600;
            font-size: 1.8rem;
            margin-bottom: 1.5rem;
            text-align: center;
        }

        .pharmacy-table {
            width: 100%;
            border-collapse: collapse;
        }

        .pharmacy-table th {
            background: var(--pharmacy-primary);
            color: white;
            padding: 1rem;
            font-weight: 500;
        }

        .pharmacy-table td {
            padding: 1rem;
            border-bottom: 1px solid #eee;
            color: #555;
        }

        .pharmacy-price {
            color: var(--pharmacy-secondary);
            font-weight: bold;
            font-size: 1.1rem;
        }

        .pharmacy-quantite-input {
            max-width: 60px;
            border-radius: 10px;
            border: 1px solid #ddd;
            padding: 0.5rem;
            text-align: center;
            font-size: 1rem;
            font-weight: bold;
            color: var(--pharmacy-primary);
            background: var(--pharmacy-card-bg);
        }

        .pharmacy-btn-primary {
            background: linear-gradient(45deg, var(--pharmacy-primary), var(--pharmacy-secondary));
            border: none;
            border-radius: 10px;
            padding: 0.75rem 1.5rem;
            font-size: 1rem;
            font-weight: 500;
            color: white;
            box-shadow: var(--pharmacy-shadow);
        }


        .pharmacy-btn-secondary {
            background: #95a5a6;
            border: none;
            border-radius: 10px;
            padding: 0.75rem 1.5rem;
            font-size: 1rem;
            font-weight: 500;
            color: white;
            transition: all 0.3s ease;
        }

        .pharmacy-btn-secondary:hover {
            background: #7f8c8d;
            transform: translateY(-2px);
        }

        .pharmacy-alert-danger {
            background-color: #e74c3c;
            color: white;
            border-radius: 10px;
            padding: 1rem;
            margin-bottom: 1.5rem;
            text-align: center;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="pharmacy-page">
        <!-- Comprimés flottants -->
        <div class="floating-pills">
            {% for i in 1..50 %}
                <div class="pill" style="
                    top: {{ random(0, 100) }}%;
                    left: {{ random(0, 100) }}%;
                    animation-delay: -{{ random(0, 10) }}s;
                    animation-duration: {{ random(5, 15) }}s;
                    opacity: {{ random(5, 10) * 0.1 }};
                "></div>
            {% endfor %}
        </div>

        <!-- Contenu principal -->
        <div class="pharmacy-container container mt-4">
            <h1 class="pharmacy-title">Modifier la commande</h1>
            <p class="pharmacy-subtitle">Ajustez les quantités des médicaments</p>

            {% for message in app.flashes('error') %}
                <div class="pharmacy-alert-danger">
                    {{ message }}
                </div>
            {% endfor %}

            {{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}
                <div class="pharmacy-card">
                    <h5 class="pharmacy-card-title">Liste des médicaments</h5>
                    <table class="pharmacy-table">
                        <thead>
                            <tr>
                                <th>Médicament</th>
                                <th>Quantité</th>
                                <th>Prix unitaire</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for medicament in medicaments %}
                                <tr>
                                    <td>{{ medicament.nom }}<br><small>{{ medicament.description }}</small></td>
                                    <td>
                                        {{ form_widget(form['quantite_' ~ medicament.id], {'attr': {'class': 'pharmacy-quantite-input'}}) }}
                                    </td>
                                    <td>
                                        <span class="pharmacy-price">{{ medicament.prix }} dt</span>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>

                    <div class="mt-4 text-center">
                        <button type="submit" class="pharmacy-btn-primary">
                            <i class="fas fa-save"></i> Enregistrer les modifications
                        </button>
                        <a href="{{ path('app_commande_index') }}" class="pharmacy-btn-secondary">
                            <i class="fas fa-arrow-left"></i> Retour à la liste
                        </a>
                    </div>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}