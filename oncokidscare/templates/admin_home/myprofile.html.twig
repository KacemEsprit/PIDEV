{% extends 'base_admin.html.twig' %}

{% block title %}Mon Profil{% endblock %}

{% block body %}
<div class="container-fluid pt-4 px-4">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">
            {{ message }}
        </div>
    {% endfor %}
    
    <div class="row g-4">
        <div class="col-12">
            <div class="bg-light rounded h-100 p-4">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h6 class="mb-0">Mon Profil</h6>
                </div>
                
                <form method="POST" enctype="multipart/form-data" action="{{ path('app_admin_profile') }}">
                    <div class="row">
                        <div class="col-sm-12 col-md-4 text-center mb-4">
                            <div class="mb-3">
                                {% if user.picture %}
                                    <img src="{{ asset('uploads/user_pictures/' ~ user.picture) }}" 
                                         class="rounded-circle mb-3" 
                                         alt="Profile Picture"
                                         style="width: 150px; height: 150px; object-fit: cover; border: 4px solid #4e73df;"
                                         id="profile-picture-preview">
                                {% else %}
                                    <img src="{{ asset('uploads/user_pictures/default.png') }}" 
                                         class="rounded-circle mb-3" 
                                         alt="Default Profile Picture"
                                         style="width: 150px; height: 150px; object-fit: cover; border: 4px solid #4e73df;"
                                         id="profile-picture-preview">
                                {% endif %}
                                <div class="mt-2">
                                    <label class="btn btn-primary btn-sm">
                                        <i class="fas fa-camera me-2"></i>Changer l'Image
                                        {{ form_widget(form.picture) }}
                                    </label>
                                    {{ form_errors(form.picture) }}
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-8">
                            <div class="row">
                                <div class="col-sm-12 col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label text-primary"><strong>First Name</strong></label>
                                        {{ form_widget(form.prenom, {'attr': {'class': 'form-control bg-light border-0'}}) }}
                                        {{ form_errors(form.prenom) }}
                                    </div>
                                </div>
                                <div class="col-sm-12 col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label text-primary"><strong>Last Name</strong></label>
                                        {{ form_widget(form.nom, {'attr': {'class': 'form-control bg-light border-0'}}) }}
                                        {{ form_errors(form.nom) }}
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-12 col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label text-primary"><strong>Email</strong></label>
                                        {{ form_widget(form.email, {'attr': {'class': 'form-control bg-light border-0'}}) }}
                                        {{ form_errors(form.email) }}
                                    </div>
                                </div>
                                <div class="col-sm-12 col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label text-primary"><strong>Phone</strong></label>
                                        {{ form_widget(form.tel, {'attr': {'class': 'form-control bg-light border-0'}}) }}
                                        {{ form_errors(form.tel) }}
                                    </div>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-primary"><strong>Address</strong></label>
                                {{ form_widget(form.adresse, {'attr': {'class': 'form-control bg-light border-0'}}) }}
                                {{ form_errors(form.adresse) }}
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-primary"><strong>New Password</strong></label>
                                {{ form_widget(form.password, {'attr': {'class': 'form-control bg-light border-0'}}) }}
                                {{ form_errors(form.password) }}
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-primary"><strong>Role</strong></label>
                                <input class="form-control bg-light border-0" type="text" value="{{ user.role|replace({'ROLE_': ''}) }}" readonly>
                            </div>
                        </div>
                        <div class="col-12">
                            <button class="btn btn-primary px-4" type="submit">
                                <i class="fas fa-save me-2"></i>Save Settings
                            </button>
                        </div>
                    </div>
                    {{ form_rest(form) }}
                </form>
            </div>
        </div>
    </div>
</div>

<style>
.bg-light {
    background-color: #f8f9fc !important;
    border: none;
    box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
}

.form-control {
    padding: 0.75rem 1rem;
    font-size: 0.9rem;
}

.form-control:focus {
    box-shadow: 0 0 0 0.25rem rgba(78, 115, 223, 0.25);
    border-color: #4e73df;
}

.btn-primary {
    background-color: #4e73df;
    border-color: #4e73df;
}

.btn-primary:hover {
    background-color: #2e59d9;
    border-color: #2e59d9;
}

.text-primary {
    color: #4e73df !important;
}

.form-label {
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
}
</style>

<script>
function previewImage(input) {
    if (input.files && input.files[0]) {
        var reader = new FileReader();
        
        reader.onload = function(e) {
            document.getElementById('profile-picture-preview').src = e.target.result;
        }
        
        reader.readAsDataURL(input.files[0]);
    }
}

document.addEventListener('DOMContentLoaded', function() {
    const form = document.querySelector('form');
    const password = document.getElementById('password');
    const passwordConfirm = document.getElementById('password_confirm');

    form.addEventListener('submit', function(e) {
        if (password.value !== passwordConfirm.value) {
            e.preventDefault();
            alert('Passwords do not match!');
        }
    });
});
</script>
{% endblock %}
