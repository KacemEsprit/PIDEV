{% extends 'base.html.twig' %}

{% block title %}Payment Successful{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-success">
                <div class="card-body text-center">
                    <i class="fas fa-check-circle text-success fa-4x mb-3"></i>
                    <h2 class="card-title mb-4">Thank You for Your Donation!</h2>
                    <p class="lead">Your payment has been processed successfully.</p>
                    
                    <div class="donation-details mt-4">
                        <h4>Donation Details</h4>
                        <table class="table table-borderless">
                            <tbody>
                                <tr>
                                    <th>Amount:</th>
                                    <td>€{{ don.montant }}</td>
                                </tr>
                                <tr>
                                    <th>Date:</th>
                                    <td>{{ don.dateDon|date('d/m/Y H:i') }}</td>
                                </tr>
                                <tr>
                                    <th>Status:</th>
                                    <td><span class="badge bg-success">{{ don.statut }}</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-4">
                        <a href="{{ path('app_donateur_dashboard') }}" class="btn btn-primary">View My Donations</a>
                        <a href="{{ path('app_home') }}" class="btn btn-outline-secondary ms-2">Return to Home</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}