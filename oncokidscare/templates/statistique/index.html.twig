{% extends 'base_admin.html.twig' %}

{% block title %}Statistiques des Médicaments{% endblock %}

{% block body %}
    <div class="container-fluid">
        <h1 class="h3 mb-4 text-gray-800">Statistiques des Médicaments</h1>

        <div class="mb-3">
            <label for="timeRangeSelect" class="form-label">Afficher les statistiques par :</label>
            <select id="timeRangeSelect" class="form-select w-auto">
                <option value="days" selected>Semaine (Jours)</option>
                <option value="months">Mois</option>
                <option value="years">Années</option>
            </select>
        </div>

        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Quantités de Médicaments Vendu au Fil du Temps</h6>
            </div>
            <div class="card-body">
                <canvas id="medicamentChart"></canvas>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const ctx = document.getElementById('medicamentChart').getContext('2d');
            let medicamentChart = null;

            const fetchChartData = (timeRange = 'days') => {
                fetch(`{{ path('app_statistique_data') }}?timeRange=${timeRange}`)
                    .then(response => response.json())
                    .then(data => {
                        if (medicamentChart) {
                            medicamentChart.destroy();
                        }
                        medicamentChart = new Chart(ctx, {
                            type: 'line',
                            data: {
                                labels: data.labels,
                                datasets: data.datasets
                            },
                            options: {
                                responsive: true,
                                interaction: {
                                    mode: 'index',
                                    intersect: false,
                                },
                                scales: {
                                    x: {
                                        title: {
                                            display: true,
                                            text: 'Date'
                                        }
                                    },
                                    y: {
                                        beginAtZero: true,
                                        title: {
                                            display: true,
                                            text: 'Quantité'
                                        }
                                    }
                                },
                                plugins: {
                                    tooltip: {
                                        callbacks: {
                                            label: function(context) {
                                                return `${context.dataset.label}: ${context.parsed.y}`;
                                            }
                                        }
                                    }
                                }
                            }
                        });
                    })
                    .catch(error => console.error('Erreur lors du chargement des données :', error));
            };

            document.getElementById('timeRangeSelect').addEventListener('change', (event) => {
                fetchChartData(event.target.value);
            });

            fetchChartData();
        });
    </script>
{% endblock %}
