{% extends 'base.html.twig' %}

{% block title %}Reset Password{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h1 class="h3 mb-3 font-weight-normal text-center">Set New Password</h1>

                    {% for message in app.flashes('danger') %}
                        <div class="alert alert-danger">
                            {{ message }}
                        </div>
                    {% endfor %}

                    {{ form_start(resetForm) }}
                        <div class="form-group">
                            <label class="form-label"><strong>{{ form_label(resetForm.plainPassword.first) }}</strong></label>
                            {{ form_widget(resetForm.plainPassword.first) }}
                            {{ form_errors(resetForm.plainPassword.first) }}
                        </div>

                        <div class="form-group mt-3">
                            <label class="form-label"><strong>{{ form_label(resetForm.plainPassword.second) }}</strong></label>
                            {{ form_widget(resetForm.plainPassword.second) }}
                            {{ form_errors(resetForm.plainPassword.second) }}
                        </div>

                        <button class="btn btn-primary w-100 mt-3" type="submit">
                            Reset Password
                        </button>
                    {{ form_end(resetForm) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
